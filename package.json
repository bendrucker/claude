{
  "name": "@bendrucker/claude",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/skill-lint",
    "plugins/claude-code/skills/session",
    "plugins/mermaid/skills/diagram",
    "plugins/style",
    "plugins/things",
    "plugins/type-ignore",
    "plugins/ui-design/skills/wireframe",
    "plugins/vscode"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:md": "npm run lint:md:agents && npm run lint:md:commands && npm run lint:md:skills",
    "lint:md:agents": "remark plugins/*/agents/*.md",
    "lint:md:commands": "remark .claude/commands/*.md plugins/*/commands/*.md",
    "lint:md:skills": "remark plugins/*/skills/*/SKILL.md",
    "test": "bun test",
    "test:unit": "bun test"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.25",
    "@biomejs/biome": "^2.3.13",
    "@constellos/claude-code-kit": "^0.4.0",
    "@linear/sdk": "^72.0.0",
    "@types/bun": "^1.3.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-lint": "^10.0.1",
    "remark-lint-frontmatter-schema": "^3.15.4"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "url-pattern": "^1.0.3"
  },
  "overrides": {
    "@apidevtools/json-schema-ref-parser": "^11.2.0"
  }
}
