{
  "description": "Sets default state for new issues based on assignee",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__linear__create_issue",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/default-state.sh"
          }
        ]
      }
    ]
  }
}
