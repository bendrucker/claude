package main

import (
	"fmt"
	"testing"
	"time"
)

func record(t *testing.T, line string) Txn {
	t.Helper()
	txn, err := decodeRecord([]byte(line))
	if err != nil {
		t.Fatal(err)
	}
	return txn
}

func TestVoidedRecordsAreSkipped(t *testing.T) {
	live := record(t, `{"account":"a","currency":"USD","at":"2026-01-01T00:00:00Z","amount":5,"memo":"live"}`)
	void := record(t, `{"account":"a","currency":"USD","at":"2026-01-02T00:00:00Z","amount":9,"memo":"void","void":true}`)
	if !void.Void || live.Void {
		t.Fatalf("void flag not decoded: live=%v void=%v", live.Void, void.Void)
	}
	groups := aggregate([]Txn{live, void})
	if len(groups) != 1 || len(groups[0].Txns) != 1 || groups[0].Txns[0].Memo != "live" {
		t.Fatalf("voided record was aggregated: %+v", groups)
	}
}

func TestVoidOnlyAccountHasNoGroup(t *testing.T) {
	void := record(t, `{"account":"b","currency":"USD","at":"2026-01-02T00:00:00Z","amount":9,"void":true}`)
	if groups := aggregate([]Txn{void}); len(groups) != 0 {
		t.Fatalf("want no groups, got %d", len(groups))
	}
}

func TestEqualTimestampsKeepFeedOrder(t *testing.T) {
	at := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
	var txns []Txn
	for i := 0; i < 60; i++ {
		txns = append(txns, Txn{Account: "a", Currency: "USD", At: at, Amount: 1, Memo: fmt.Sprint(i)})
	}
	got := aggregate(txns)[0].Txns
	for i, txn := range got {
		if txn.Memo != fmt.Sprint(i) {
			t.Fatalf("position %d holds memo %s", i, txn.Memo)
		}
	}
}

func TestGroupsAreInTimeOrder(t *testing.T) {
	late := record(t, `{"account":"a","currency":"USD","at":"2026-03-01T00:00:00Z","amount":1,"memo":"late"}`)
	early := record(t, `{"account":"a","currency":"USD","at":"2026-01-01T00:00:00Z","amount":1,"memo":"early"}`)
	got := aggregate([]Txn{late, early})[0].Txns
	if got[0].Memo != "early" || got[1].Memo != "late" {
		t.Fatalf("out of order: %s, %s", got[0].Memo, got[1].Memo)
	}
}
