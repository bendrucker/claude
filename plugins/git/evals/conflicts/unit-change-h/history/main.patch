diff --git a/lib/size.sh b/lib/size.sh
index 8e4f97d..f130aa3 100644
--- a/lib/size.sh
+++ b/lib/size.sh
@@ -1,13 +1,15 @@
 #!/usr/bin/env bash
 
-# human_size <kilobytes>: prints a size such as 1.5 MB.
+# human_size <bytes>: prints a size such as 1.5 MB.
 human_size() {
-  local kb=$1
-  if [ "$kb" -ge 1048576 ]; then
-    printf '%d.%d GB\n' $((kb / 1048576)) $((kb * 10 / 1048576 % 10))
-  elif [ "$kb" -ge 1024 ]; then
-    printf '%d.%d MB\n' $((kb / 1024)) $((kb * 10 / 1024 % 10))
+  local bytes=$1
+  if [ "$bytes" -ge 1073741824 ]; then
+    printf '%d.%d GB\n' $((bytes / 1073741824)) $((bytes * 10 / 1073741824 % 10))
+  elif [ "$bytes" -ge 1048576 ]; then
+    printf '%d.%d MB\n' $((bytes / 1048576)) $((bytes * 10 / 1048576 % 10))
+  elif [ "$bytes" -ge 1024 ]; then
+    printf '%d KB\n' $((bytes / 1024))
   else
-    printf '%d KB\n' "$kb"
+    printf '%d B\n' "$bytes"
   fi
 }
