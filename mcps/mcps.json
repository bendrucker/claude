{
  "$schema": "./cli/schema/mcps.json",
  "servers": {
    "github": {
      "runner": {
        "http": {
          "url": "https://api.githubcopilot.com/mcp/",
          "headers": {
            "Authorization": "Bearer ${GITHUB_TOKEN}"
          }
        }
      },
      "targets": {
        "scope": "user"
      }
    },
    "terraform": {
      "runner": {
        "docker": {
          "service": "terraform"
        }
      },
      "targets": {
        "scope": "project",
        "labels": {
          "language": ["terraform"]
        }
      }
    },
    "aws-docs": {
      "runner": {
        "uvx": {
          "package": "awslabs.aws-documentation-mcp-server",
          "env": {
            "FASTMCP_LOG_LEVEL": "ERROR",
            "AWS_DOCUMENTATION_PARTITION": "aws"
          }
        }
      },
      "targets": {
        "scope": "user"
      }
    },
    "package-registry": {
      "runner": {
        "npm": {
          "package": "package-registry-mcp"
        }
      },
      "targets": {
        "scope": "user"
      }
    },
    "playwright": {
      "runner": {
        "npm": {
          "package": "@playwright/mcp"
        }
      },
      "targets": {
        "scope": "project",
        "labels": {
          "type": ["frontend", "e2e-testing"]
        }
      }
    },
    "markitdown": {
      "runner": {
        "uvx": {
          "package": "markitdown-mcp"
        }
      },
      "targets": {
        "scope": "user"
      }
    }
  }
}
