{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(pbcopy:*)", "Bash(pbpaste:*)"]
  },
  "sandbox": {
    "network": {
      "allowUnixSockets": [
        "~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
      ]
    },
    "excludedCommands": [
      "pbcopy:*",
      "pbpaste:*",
      "security:*",
      "defaults:*",
      "launchctl:*",
      "screencapture:*",
      "say:*",
      "afplay:*",
      "diskutil:*",
      "networksetup:*",
      "open:*",
      "osascript:*",
      "shortcuts:*",
      "swift:*",
      "xcrun:*",
      "mdfind:*",
      "mdls:*",
      "xattr:*",
      "dscl:*",
      "plutil:*"
    ]
  }
}
