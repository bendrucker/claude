---
import type { CatalogPlugin } from "../data/catalog";
import { withBase } from "../lib/base";
import ChipList from "./ChipList.astro";

interface Props {
  plugin: CatalogPlugin;
}

const { plugin } = Astro.props;
const href = withBase(plugin.route);
const updated = plugin.history?.lastCommit ?? plugin.history?.firstCommit ?? "";
---

<li
  data-plugin-card
  data-name={plugin.name}
  data-category={plugin.category ?? ""}
  data-updated={updated}
  class="list-none"
>
  <a
    href={href}
    data-plugin-nav={plugin.name}
    class="block h-full rounded-lg border border-border bg-surface p-4 transition-colors hover:border-accent"
  >
    <div class="mb-1 flex items-start justify-between gap-2">
      <h3 class="font-mono text-sm font-semibold">{plugin.name}</h3>
      {
        plugin.category && (
          <span class="shrink-0 text-[10px] font-medium uppercase tracking-wide text-muted">
            {plugin.category}
          </span>
        )
      }
    </div>
    {plugin.description && <p class="mb-3 line-clamp-2 text-sm text-muted">{plugin.description}</p>}
    <ChipList plugin={plugin} />
    <p class="mt-2 hidden text-xs text-accent" data-match-note></p>
  </a>
</li>
