+trace_end
 
+trace_begin install-symlinks
 ./scripts/install-symlinks
+trace_end
 
+trace_begin install-topics
 ./scripts/install-topics
+trace_end
 
 # Reconcile theme-managed configs to the active flavor. Runs after every
 # installer so each config exists; failures here shouldn't abort an otherwise
 # successful install.
+trace_begin theme-sync
 ./theme/bin/theme-sync || gum log --level warn "theme-sync had issues"
+trace_end
 
 # Hand the new config to whatever is already running with the old one, after
