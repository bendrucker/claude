+
+async function screen(ctx: Context): Promise<string | null> {
+  const result = await ctx.run(["herdr", "pane", "read", ctx.partial.pane, "--source", "visible"]);
+  return result.code === 0 ? result.stdout : null;
+}
+
+// Waits for SCREEN_STEADY_SAMPLES identical reads, or the dispatch timeout's
+// worth of polls.
+async function screenSettled(
+  ctx: Context,
+  polls = Math.ceil(ctx.options.timeout / POLL_MS),
+  previous: string | null = null,
+  streak = 0,
+): Promise<void> {
+  const current = await screen(ctx);
+  const agreeing = current != null && current === previous ? streak + 1 : 1;
+  if (agreeing >= SCREEN_STEADY_SAMPLES || polls <= 1) return;
+  await ctx.pause(POLL_MS);
+  return screenSettled(ctx, polls - 1, current, agreeing);
+}
