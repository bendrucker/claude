{
  "description": "Blocks direct commits to the default branch",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/block-default-branch-commit.ts\"",
            "if": "Bash(git commit:*)"
          }
        ]
      }
    ]
  }
}
