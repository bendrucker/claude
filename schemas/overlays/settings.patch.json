[
  {
    "op": "add",
    "path": "/properties/skipAutoPermissionPrompt",
    "value": {
      "type": "boolean",
      "description": "Skip the automatic permission prompt when a tool requests access"
    }
  },
  {
    "op": "add",
    "path": "/properties/skipWorkflowUsageWarning",
    "value": {
      "type": "boolean",
      "description": "Suppress the warning shown when workflow usage limits are approached"
    }
  },
  {
    "op": "add",
    "path": "/properties/autoCompactWindow",
    "value": {
      "type": "integer",
      "minimum": 100000,
      "maximum": 1000000,
      "description": "Auto-compact window size in tokens"
    }
  },
  {
    "op": "add",
    "path": "/properties/prependPlugins",
    "value": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Managed plugins whose hooks run first, outermost, in the listed order. When set, sec-default@builtin seats only where listed"
    }
  }
]
