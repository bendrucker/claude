{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "node:fs": {
                "allowImportNames": [
                  "globSync",
                  "mkdirSync",
                  "mkdtempSync",
                  "readdirSync",
                  "realpathSync"
                ],
                "message": "Use Bun file APIs (Bun.file, Bun.write) instead of node:fs. Sync directory operations (glob, mkdir, mkdtemp, readdir, realpath) are allowed."
              },
              "node:fs/promises": {
                "allowImportNames": ["mkdir", "mkdtemp", "readdir", "rm"],
                "message": "Use Bun file APIs (Bun.file, Bun.write) instead of node:fs/promises. Directory operations (mkdir, mkdtemp, readdir, rm) are allowed."
              },
              "fs": "Use \"node:fs\" with allowed directory operations, or Bun file APIs for file operations.",
              "fs/promises": "Use \"node:fs/promises\" with allowed directory operations, or Bun file APIs for file operations."
            }
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": ["**/*.ts", "**/*.js", "**/*.json"],
    "ignoreUnknown": true
  },
  "overrides": [
    {
      "includes": ["**/fixtures/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [".vscode/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/scripts/jxa/**/*.js"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
