wt -C /tmp/eval/cwd switch --create explain-delay --base origin/main --no-cd --yes --format=json
rex window new -s session:eval explain-delay -c /tmp/eval/cwd/.worktrees/explain-delay --json -- claude --name explain-delay -- <prompt>
launch explain-delay /tmp/eval/cwd/.worktrees/explain-delay
allow Bash(bun test:*)
