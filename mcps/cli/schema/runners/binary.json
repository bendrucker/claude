{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Binary Runner Schema",
  "description": "Configuration for binary executable MCP runners",
  "type": "object",
  "required": ["binary"],
  "properties": {
    "binary": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {
          "type": "string",
          "description": "Command to execute"
        },
        "args": {
          "type": "array",
          "description": "Command arguments",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "description": "Environment variables",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}