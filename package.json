{
  "name": "@bendrucker/claude",
  "private": true,
  "type": "module",
  "workspaces": [
    ".claude/skills/*"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "npm run lint:agents && npm run lint:commands && npm run lint:skills",
    "lint:agents": "remark .claude/agents/*.md",
    "lint:commands": "remark .claude/commands/*.md",
    "lint:skills": "remark .claude/skills/*/SKILL.md"
  },
  "devDependencies": {
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-lint": "^10.0.1",
    "remark-lint-frontmatter-schema": "^3.15.4"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  }
}
