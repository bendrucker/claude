+import { describe, expect, test } from "bun:test";
+import { lineCoverage, parseLcov, totalCoverage } from "./lcov";
+
+const sample = "SF:src/a.ts\nDA:1,1\nDA:2,0\nFNF:2\nFNH:1\nend_of_record\n";
+
+describe("parseLcov", () => {
+  test("reads a record", () => {
+    const [fc] = parseLcov(sample);
+    expect(fc.file).toBe("src/a.ts");
+    expect(fc.lineHits.get(2)).toBe(0);
+    expect(fc.functionsFound).toBe(2);
+  });
+
+  test("ignores lines outside a record", () => {
+    expect(parseLcov("DA:1,1\n")).toEqual([]);
+  });
+});
+
+describe("coverage", () => {
+  test("lineCoverage", () => {
+    expect(lineCoverage(parseLcov(sample)[0]).pct).toBe(50);
+  });
+
+  test("totalCoverage", () => {
+    expect(totalCoverage(parseLcov(sample))).toBe(50);
+  });
+});
