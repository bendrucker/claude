{
  "description": "Linear plugin hooks for WebFetch blocking and issue defaults",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch(domain:linear.app)",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/fetch.ts\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__linear__create_issue|mcp__plugin_linear_linear__create_issue|mcp__claude_ai_Linear__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/default-state.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
