{
  "name": "@bendrucker/claude",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/things/skills/things"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "npm run lint:agents && npm run lint:commands && npm run lint:skills",
    "lint:agents": "remark plugins/*/agents/*.md",
    "lint:commands": "remark .claude/commands/*.md plugins/*/commands/*.md",
    "lint:skills": "remark plugins/*/skills/*/SKILL.md"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-lint": "^10.0.1",
    "remark-lint-frontmatter-schema": "^3.15.4"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@apidevtools/json-schema-ref-parser": "^11.2.0"
  }
}
