<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>me.bendrucker.things-mcp</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/bun</string>
		<string>/Users/ben/src/bendrucker/claude/plugins/things/src/mcp/server.ts</string>
		<string>--port</string>
		<string>3111</string>
		<string>--authorization-server</string>
		<string>https://idp.TAILNET.ts.net</string>
		<string>--resource</string>
		<string>https://HOST.TAILNET.ts.net/mcp</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/ben/Library/Logs/things-mcp.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/ben/Library/Logs/things-mcp.log</string>
</dict>
</plist>
