    "simple-git": "^3.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
