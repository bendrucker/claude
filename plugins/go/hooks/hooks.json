{
  "description": "Blocks modification of generated Go files",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ${CLAUDE_PLUGIN_ROOT}/scripts/check.ts"
          }
        ]
      }
    ]
  }
}
