diff --git a/test/run.sh b/test/run.sh
new file mode 100644
index 0000000..a644535
--- /dev/null
+++ b/test/run.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -u
+here=$(cd "$(dirname "$0")/.." && pwd)
+for lib in size report backup cleanup status; do
+  . "$here/lib/$lib.sh"
+done
+
+fail=0
+check() {
+  if [ "$1" != "$2" ]; then
+    echo "want '$1', got '$2'" >&2
+    fail=1
+  fi
+}
+
+check "512 KB" "$(human_size 512)"
+check "1.5 MB" "$(human_size 1536)"
+check "disk: 2.0 MB" "$(report_disk 2048)"
+check "backup: 3.0 GB" "$(backup_size 3145728)"
+check "freed: 700 KB" "$(cleanup_freed 700)"
+check "cache: 1.0 MB" "$(status_cache 1024)"
+exit "$fail"
