{
  "description": "Blocks direct commits to the default branch",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/block-default-branch-commit.sh"
          }
        ]
      }
    ]
  }
}
