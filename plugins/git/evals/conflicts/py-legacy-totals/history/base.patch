@@ -0,0 +1,18 @@
+import unittest
+
+from billing.summary import summarize
+
+
+class SummaryTest(unittest.TestCase):
+    def test_totals(self):
+        invoices = [
+            {"id": "a", "lines": [{"qty": 2, "price": 10.0}]},
+            {"id": "b", "lines": [{"qty": 1, "price": 5.0}]},
+        ]
+        out = summarize(invoices, tax_rate=0)
+        self.assertEqual(out["count"], 2)
+        self.assertEqual(out["total"], 25.0)
+        self.assertEqual(out["largest"], "a")
+
+    def test_empty(self):
+        self.assertIsNone(summarize([])["largest"])
