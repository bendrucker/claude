{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "THINGS_EXTRA_TAGS": "claude-code"
  },
  "permissions": {
    "allow": [
      "Bash(gh extension list)",
      "Bash(gh search prs:*)",
      "Bash(npm view:*)",
      "Bash(shellcheck:*)",
      "Bash(brew info:*)",
      "WebFetch(domain:www.schemastore.org)",
      "Skill(bun:bun)",
      "Skill(claude-code:hook)",
      "Skill(claude-code:session)",
      "Skill(claude-code:skill)",
      "Skill(git:conflicts)",
      "Skill(github:actions-monitor)",
      "Skill(github:pr-comments)",
      "Skill(pull-request:babysit)",
      "Skill(pull-request:create)",
      "Skill(pull-request:follow-up)",
      "Skill(pull-request:update)",
      "Skill(review:code)",
      "Skill(review:inbox)",
      "Skill(review:peer)",
      "Skill(review:self)",
      "Skill(update-config)",
      "Skill(writing:review)",
      "Skill(writing:writing)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/ox\"",
            "if": "Bash(git commit:*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/ox\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/ox\""
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/plugin-imports\""
          },
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/plugin-deps\""
          },
          {
            "type": "command",
            "command": "PREK_HOME=\"$CLAUDE_PROJECT_DIR/.prek\" bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop\""
          }
        ]
      }
    ]
  }
}
