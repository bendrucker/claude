{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UVX Runner Schema",
  "description": "Configuration for UVX (Python) based MCP runners",
  "type": "object",
  "required": ["uvx"],
  "properties": {
    "uvx": {
      "type": "object",
      "required": ["package"],
      "properties": {
        "package": {
          "type": "string",
          "description": "Python package name"
        },
        "env": {
          "type": "object",
          "description": "Environment variables",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}