@@ -0,0 +1,15 @@
+import { describe, expect, test } from "bun:test";
+import { parseLcov } from "./reader";
+
+describe("parseLcov", () => {
+  test("reads a record", () => {
+    const [fc] = parseLcov("SF:src/a.ts\nDA:1,1\nDA:2,0\nFNF:2\nFNH:1\nend_of_record\n");
+    expect(fc.file).toBe("src/a.ts");
+    expect(fc.lineHits.get(2)).toBe(0);
+    expect(fc.functionsFound).toBe(2);
+  });
+
+  test("ignores lines outside a record", () => {
+    expect(parseLcov("DA:1,1\n")).toEqual([]);
+  });
+});
diff --git a/src/reader.ts b/src/reader.ts
new file mode 100644
index 0000000..2d00161
--- /dev/null
+++ b/src/reader.ts
@@ -0,0 +1,35 @@
+import type { FileCoverage } from "./lcov";
+
+export function parseLcov(text: string): FileCoverage[] {
+  const records: FileCoverage[] = [];
+  let current: FileCoverage | null = null;
+
+  for (const raw of text.split("\n")) {
+    const line = raw;
+    if (line === "") continue;
+
+    if (line.startsWith("SF:")) {
+      current = {
+        file: line.slice(3),
+        lineHits: new Map(),
+        functionsFound: 0,
+        functionsHit: 0,
+      };
+      continue;
+    }
+    if (!current) continue;
+
+    if (line.startsWith("DA:")) {
+      const [lineNo, count] = line.slice(3).split(",");
+      current.lineHits.set(Number(lineNo), Number(count));
+    } else if (line.startsWith("FNF:")) {
+      current.functionsFound = Number(line.slice(4));
+    } else if (line.startsWith("FNH:")) {
+      current.functionsHit = Number(line.slice(4));
+    } else if (line === "end_of_record") {
+      records.push(current);
+      current = null;
+    }
+  }
+  return records;
+}
