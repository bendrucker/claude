{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(man:*)",
      "Bash(wt list:*)",
      "Bash(wt --help:*)",
      "Bash(wt --version:*)",
      "Bash(wt config:*)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:rubygems.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:proxy.golang.org)",
      "WebFetch(domain:sum.golang.org)",
      "WebFetch(domain:pkg.go.dev)",
      "Edit(//tmp/**)",
      "Edit(tmp/**)",
      "Edit(.git/config)",
      "Edit(.git/config.lock)",
      "Edit(.worktrees/**)",
      "Edit(~/.npm/**)",
      "Edit(~/.terraform.d/plugin-cache/**)",
      "Edit(~/.cache/uv/**)",
      "Edit(~/Library/Caches/go-build/**)",
      "Edit(~/src/go/pkg/mod/**)",
      "Edit(~/src/go/pkg/sumdb/**)",
      "Edit(~/.bun/**)",
      "Read(~/.claude/plugins/**)",
      "Edit(~/.claude/plugins/cache/**/node_modules/**)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/worktree",
            "if": "Bash(git worktree *)"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/webfetch-block"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "go@bendrucker": true,
    "mac@bendrucker": true,
    "git@bendrucker": true,
    "gitlab@bendrucker": true,
    "linear@bendrucker": true,
    "things@bendrucker": true,
    "issue@bendrucker": true,
    "review@bendrucker": true,
    "newline@bendrucker": true,
    "github@bendrucker": true,
    "claude-code@bendrucker": true,
    "pull-request@bendrucker": true,
    "interview@bendrucker": true,
    "linear@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "astral@astral-sh": true,
    "personal-review@bendrucker": true,
    "x-callback-url@bendrucker": true,
    "calendar@bendrucker": true,
    "research@bendrucker": true,
    "writing@bendrucker": true,
    "type-ignore@bendrucker": true,
    "agents-md@bendrucker": true,
    "ast-grep@ast-grep-marketplace": true,
    "worktrunk@worktrunk": true,
    "vscode@bendrucker": true,
    "plan@bendrucker": true,
    "playground@claude-plugins-official": true,
    "linear-cli@linear-cli": true,
    "tmux@bendrucker": true,
    "agent-browser@agent-browser": true,
    "bun@bendrucker": true,
    "git-town@bendrucker": true,
    "mermaid@bendrucker": true,
    "tech-spec@bendrucker": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "bendrucker": {
      "source": {
        "source": "github",
        "repo": "bendrucker/claude"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official",
        "ref": "27d2b86d72da27c64585150857cee8472ad47abb"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins",
        "ref": "f8034678a15ad751aae6a2b684daebac416267a1"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/claude-skill",
        "ref": "577f4d4507678f2c8cee150fae25e6ce309f70b1"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk",
        "ref": "v0.33.0"
      }
    },
    "linear-cli": {
      "source": {
        "source": "github",
        "repo": "schpet/linear-cli",
        "ref": "v1.11.1"
      }
    },
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser",
        "ref": "v0.23.0"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh",
        "~/.tmux/tmux-501/default"
      ]
    },
    "excludedCommands": [
      "docker:*",
      "ssh:*",
      "scp:*",
      "rsync:*",
      "aws:*",
      "gcloud:*",
      "az:*",
      "wt:*",
      "claude:*",
      "agent-browser:*",
      "bun link:*",
      "pbcopy:*",
      "pbpaste:*",
      "security:*",
      "defaults:*",
      "launchctl:*",
      "screencapture:*",
      "say:*",
      "afplay:*",
      "diskutil:*",
      "networksetup:*",
      "open:*",
      "osascript:*",
      "shortcuts:*",
      "swift:*",
      "xcrun:*",
      "mdfind:*",
      "mdls:*",
      "xattr:*",
      "dscl:*",
      "plutil:*",
      "gh:*",
      "code:*"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "alwaysThinkingEnabled": true,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "TMPDIR": "/tmp",
    "TMPPREFIX": "/tmp/claude/zsh",
    "WORKTRUNK_WORKTREE_PATH": ".worktrees/{{ branch | sanitize }}",
    "CLAUDE_CODE_NO_FLICKER": "1"
  }
}
