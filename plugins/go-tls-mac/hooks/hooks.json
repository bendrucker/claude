{
  "description": "Disable sandbox for Go binaries on macOS to fix TLS cert verification",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/sandbox.ts"
          }
        ]
      }
    ]
  }
}
