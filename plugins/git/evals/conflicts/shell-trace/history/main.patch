diff --git a/scripts/install-topics b/scripts/install-topics
deleted file mode 100755
index fece34f..0000000
--- a/scripts/install-topics
+++ /dev/null
@@ -1,61 +0,0 @@
-#!/usr/bin/env sh
-# Usage: install-topics [dotfiles-root]
-#
-# Run every topic installer.
-#
-# A topic is a directory at the repository root, so an installer is
-# <root>/<topic>/install.sh and never anything deeper. That one level of depth
-# is the whole bound. A git worktree under .worktrees/ holds a full second copy
-# of the tree, and a recursive walk found the installers in it and ran them.
-# That fails rather than merely repeating work, because an installer operates
-# on $ZSH, the installed tree. A copy from another branch sources a path this
-# repo has since renamed, and the nightly job dies on a file that does not
-# exist. The same bound keeps .git, node_modules, tmp's contents, and a
-# submodule's own tree out without naming any of them.
-set -e
-
-DOTFILES_ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd -P)}"
-cd "$DOTFILES_ROOT"
-
-# A submodule is another project's repo and its installer is not ours to run.
-# .gitmodules is what this repo declares, so reading it answers for a submodule
-# nobody has initialized. `git submodule foreach` reports only the initialized
-# ones and recurses into each, and a checkout broken in there would report no
-# submodules at all and let their installers run.
-declares_submodule() {
-  [ -f .gitmodules ] || return 1
-
-  # --fixed-value compares the value literally, so a path holding a space or a
-  # regex metacharacter matches as itself. A section name may hold a space too,
-  # which is why the match is git's to make rather than something to cut apart.
-  git config -f .gitmodules --get-regexp --fixed-value \
-    '^submodule\..*\.path$' "$1" >/dev/null
-  status=$?
-
-  # 1 is "no section matched", the answer for an ordinary topic. Anything else
-  # is a .gitmodules this run could not read, and reading that as "not a
-  # submodule" runs an installer that is not ours. A condition context turns
-  # off set -e, so the abort has to be spelled out here.
-  case $status in
-    0 | 1) return $status ;;
-  esac
-  echo "install-topics: cannot read .gitmodules (git config exited $status)" >&2
-  exit $status
-}
-
-for installer in */install.sh; do
-  # A glob that matches nothing stays literal in sh. -e rather than -f so that
-  # an install.sh which is somehow a directory fails loudly on the exec below
-  # instead of reading as a topic that has no installer.
-  [ -e "$installer" ] || continue
-
-  topic=${installer%/install.sh}
-  # scripts/install sources mise/install.sh ahead of this, so the runtimes it
-  # installs are on $PATH for every topic that follows.
-  case $topic in
-    mise) continue ;;
-  esac
-  if declares_submodule "$topic"; then continue; fi
-
-  "./$installer"
-done
diff --git a/scripts/shell/trace.sh b/scripts/shell/trace.sh
new file mode 100644
index 0000000..3e23b79
--- /dev/null
+++ b/scripts/shell/trace.sh
@@ -0,0 +1,36 @@
+# shellcheck shell=dash
+# Span markers for the bootstrap path, read by scripts/trace-report. Inert
+# unless DOTFILES_TRACE_DIR is set. POSIX: it is sourced before bun exists.
+# trace_begin <name> and trace_end bracket a step, keeping $?.
+
+# Fractions are padded or cut to nine digits: zsh prints ten, bash six.
+trace_now() {
+  if [ -n "${EPOCHREALTIME-}" ]; then
+    _trace_f=${EPOCHREALTIME#*[.,]}000000000
+    trace_t=${EPOCHREALTIME%[.,]*}${_trace_f%"${_trace_f#?????????}"}
+    # Bare, bash 5.2 returns the status the EXIT trap fired with, and set -e quits.
+    return 0
+  fi
+  trace_t=$(date +%s%N)
+  case $trace_t in *[!0-9]* | "") trace_t=$(perl -MTime::HiRes=time -e 'printf "%.0f", time * 1e9' 2>/dev/null || echo "$(date +%s)000000000") ;; esac
+}
+
+trace_mark() {
+  trace_now
+  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$trace_t" "$$" "$2" "$(printf %s "$3" | tr '\t\n' '  ')" >>"$DOTFILES_TRACE_DIR/events.tsv"
+}
+
+trace_begin() { [ -n "${DOTFILES_TRACE_DIR-}" ] && trace_mark B 0 "$1"; return 0; }
+trace_end() { _trace_s=$?; [ -n "${DOTFILES_TRACE_DIR-}" ] && trace_mark E "$_trace_s" ""; return "$_trace_s"; }
+
+# A failure under set -e skips every trace_end, so an EXIT trap records the
+# exit status as an X line.
+if [ -n "${DOTFILES_TRACE_DIR-}" ]; then
+  [ -n "${ZSH_VERSION-}" ] && zmodload zsh/datetime
+  mkdir -p "$DOTFILES_TRACE_DIR"
+  if [ -z "${GIT_TRACE2_EVENT-}" ]; then
+    mkdir -p "$DOTFILES_TRACE_DIR/git"
+    export GIT_TRACE2_EVENT="$DOTFILES_TRACE_DIR/git"
+  fi
+  trap '_trace_s=$?; trace_now; printf "X\t%s\t%s\t%s\n" "$trace_t" "$$" "$_trace_s" >>"$DOTFILES_TRACE_DIR/events.tsv"' EXIT
+fi
