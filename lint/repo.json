{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../node_modules/@bendrucker/oxlint-config/base.json",
    "../node_modules/@bendrucker/oxlint-config/typescript.json",
    "../node_modules/@bendrucker/oxlint-config/bun.json"
  ],
  "rules": {
    "import/no-namespace": [
      "error",
      { "ignore": ["@hegeldev/hegel", "@hegeldev/hegel/generators"] }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.workflow.js", "plugins/*/mod/**"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["plugins/*/mod/**"],
      "rules": {
        "typescript/strict-boolean-expressions": "off",
        "unicorn/no-array-fill-with-reference-type": "off",
        "unicorn/catch-error-name": "off",
        "promise/no-callback-in-promise": "off"
      }
    },
    {
      // tsgolint spends 30-40s per file checking the return type of each
      // handler passed to the engine's generic `on` overloads.
      "files": ["plugins/*/mod/register*"],
      "rules": {
        "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "arguments": false } }],
        "typescript/strict-void-return": "off"
      }
    }
  ]
}
