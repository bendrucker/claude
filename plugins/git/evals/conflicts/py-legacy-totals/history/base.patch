+"""Invoice totals for the monthly summary."""
+
+
+def invoice_total(lines, tax_rate):
+    subtotal = sum(line["qty"] * line["price"] for line in lines)
+    return round(subtotal * (1 + tax_rate), 2)
diff --git a/billing/summary.py b/billing/summary.py
new file mode 100644
index 0000000..3c79768
--- /dev/null
+++ b/billing/summary.py
@@ -0,0 +1,10 @@
+from billing.legacy_totals import invoice_total
+
+
+def summarize(invoices, tax_rate=0.08):
+    totals = {inv["id"]: invoice_total(inv["lines"], tax_rate) for inv in invoices}
+    return {
+        "count": len(totals),
+        "total": round(sum(totals.values()), 2),
+        "largest": max(totals, key=totals.get) if totals else None,
+    }
