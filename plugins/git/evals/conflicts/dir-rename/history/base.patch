+
+  const stall = (ms: number) =>
+    `2026-09-02T01:52:13.631Z [INFO] [Stall] classifier_request_finished reqId=r${ms} tool=Bash stage=xml_s1 outcome=ok durationMs=${ms}\n`;
+  const record = (id: string) =>
