{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/bendrucker/claude/main/schemas/plugin-hooks.schema.json",
  "title": "Claude Code Plugin Hooks Schema",
  "description": "Schema for Claude Code plugin hooks.json files",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Description of what the hooks do"
    },
    "hooks": {
      "$ref": "hooks.schema.json"
    }
  },
  "required": ["hooks"],
  "additionalProperties": false
}
