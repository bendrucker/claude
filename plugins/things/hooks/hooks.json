{
  "description": "Validates osascript commands target Things3 plugin scripts or inline Things3 queries",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(osascript:*)",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/validate-jxa.ts"
          }
        ]
      }
    ]
  }
}
