+import unittest
+
+from tally.ingest import load
+
+
+class LoadTest(unittest.TestCase):
+    def test_batches_of_one_hundred(self):
+        seen = []
+        self.assertEqual(load(list(range(1, 251)), seen.append), 3)
+        self.assertEqual([len(batch) for batch in seen], [100, 100, 50])
