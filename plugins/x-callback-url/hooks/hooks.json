{
  "description": "Disables sandbox for xcall scripts that need Launch Services XPC access",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(bun ${CLAUDE_PLUGIN_ROOT}/scripts/:*)",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/sandbox.ts\""
          }
        ]
      }
    ]
  }
}
