+from tally.seq import split_chunks
+
+
+def csv_files(rows, per_file):
+    """Renders rows as CSV bodies of at most per_file rows each."""
+    return [
+        "\n".join(",".join(map(str, row)) for row in chunk)
+        for chunk in split_chunks(rows, per_file)
+    ]
