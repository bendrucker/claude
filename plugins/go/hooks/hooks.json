{
  "description": "Blocks modification of generated Go files",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/check.ts\"",
            "if": "Edit(**/*.go)|MultiEdit(**/*.go)|Write(**/*.go)"
          }
        ]
      }
    ]
  }
}
