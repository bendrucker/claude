{
  "description": "GitLab URL transforms, auth expiration recovery, and gh-ism linting, and watches the current branch's merge request, showing its pipeline and approval state at the end of the prompt footer (function hooks)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/fetch.ts\"",
            "if": "WebFetch(domain:gitlab.com)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.ts\"",
            "if": "Bash(glab *)"
          },
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/lint.ts\"",
            "if": "Bash(gh *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/auth.ts\"",
            "if": "Bash(glab *)"
          }
        ]
      }
    ]
  },
  "modules": ["../mod/register.ts"]
}
