{
  "description": "Transforms GitLab URLs into API requests for better content fetching",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/fetch.sh"
          }
        ]
      }
    ]
  }
}
