{
  "description": "Blocks direct commits to the default branch, recovers SSH-agent auth failures over HTTPS, and stops retries of refused commit signatures",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/block-default-branch-commit.ts\"",
            "if": "Bash(git commit:*)"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/https-fallback.ts\"",
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/signing-refusal.ts\"",
            "if": "Bash(git *)"
          }
        ]
      }
    ]
  }
}
