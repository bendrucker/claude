{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "git -C ~/.claude-repo pull --ff-only --quiet && /opt/dotfiles/claude/link cloud >/dev/null",
            "async": true
          }
        ]
      }
    ]
  }
}
