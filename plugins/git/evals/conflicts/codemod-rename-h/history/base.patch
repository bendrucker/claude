--- /dev/null
+++ b/tally/seq.py
@@ -0,0 +1,4 @@
+def split_chunks(items, size):
+    """Yields consecutive slices of items, each at most size long."""
+    for start in range(0, len(items), size):
+        yield items[start : start + size]
