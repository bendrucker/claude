{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Docker Runner Schema",
  "description": "Configuration for Docker-based MCP runners",
  "type": "object",
  "required": ["docker"],
  "properties": {
    "docker": {
      "type": "object",
      "required": ["service"],
      "properties": {
        "service": {
          "type": "string",
          "description": "Docker service name"
        },
        "image": {
          "type": "string",
          "description": "Docker image name (optional)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}