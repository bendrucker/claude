{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise", "node", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "max-depth": "error",
    "no-await-in-loop": "error",
    "no-duplicate-imports": "error",
    "no-empty": "error",
    // An empty function body stands in for logic that was never written,
    // so a caller invoking it gets silence instead of an error.
    "no-empty-function": "error",
    "no-lonely-if": "error",
    "no-template-curly-in-string": "warn",
    "no-underscore-dangle": ["error", { "allow": ["__typename", "__dirname"] }],
    "no-unsafe-optional-chaining": "off",
    "no-unused-expressions": ["error", { "allowTernary": true }],
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "prefer-object-spread": "error",
    "prefer-template": "error",
    "import/no-namespace": ["error", { "ignore": ["fast-check"] }],
    "oxc/no-map-spread": "error",
    "promise/avoid-new": "error",
    "unicorn/catch-error-name": "error",
    "unicorn/custom-error-definition": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/no-array-for-each": "error",
    // A `.reduce()` accumulator's shape lives inside the callback, so a
    // reader has to simulate the whole loop to see what's being built.
    "unicorn/no-array-reduce": "error",
    // An object literal default only applies when the whole argument is
    // omitted, so it reads like per-field fallbacks it doesn't provide.
    "unicorn/no-object-as-default-parameter": "error",
    "unicorn/prefer-array-find": "error",
    // Reassigning a parameter to fill in a missing value hides the
    // fallback in the function body instead of the signature.
    "unicorn/prefer-default-parameters": "error",
    "unicorn/prefer-export-from": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/prefer-string-raw": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-string-slice": "error",
    // The vitest plugin matches the Jest-style API shape, not the import, so it
    // covers this repo's bun:test suites. These two rules read source prose and
    // ordinary loops as tests, so they run only over test files.
    "vitest/no-commented-out-tests": "off",
    "vitest/prefer-each": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "vitest/no-commented-out-tests": "error",
        "vitest/prefer-each": "error"
      }
    }
  ]
}
