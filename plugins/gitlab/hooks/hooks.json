{
  "description": "GitLab URL transforms and auth expiration recovery",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/fetch.ts\"",
            "if": "WebFetch(https://gitlab.com/*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/auth.ts\"",
            "if": "Bash(glab *)"
          }
        ]
      }
    ]
  }
}
