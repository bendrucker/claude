{
  "name": "@bendrucker/claude-eval",
  "version": "1.0.0",
  "description": "Evaluate Claude configuration changes",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/cli.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.35",
    "@anthropic-ai/sdk": "^0.55.0",
    "cleye": "^1.3.2",
