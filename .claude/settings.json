{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "THINGS_EXTRA_TAGS": "claude-code"
  },
  "permissions": {
    "allow": [
      "Bash(gh extension list)",
      "Bash(gh search prs:*)",
      "Bash(npm view:*)",
      "Bash(shellcheck:*)",
      "Bash(brew info:*)",
      "WebFetch(domain:www.schemastore.org)",
      "Skill(bun:bun)",
      "Skill(git:conflicts)",
      "Skill(github:actions-monitor)",
      "Skill(github:pr-comments)",
      "Skill(observability:session)",
      "Skill(plugin:hook)",
      "Skill(plugin:skill)",
      "Skill(pull-request:babysit)",
      "Skill(pull-request:create)",
      "Skill(pull-request:follow-up)",
      "Skill(pull-request:update)",
      "Skill(code-review)",
      "Skill(review:inbox)",
      "Skill(review:peer)",
      "Skill(update-config)",
      "Skill(writing:review)",
      "Skill(writing:writing)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/mod-types\"",
            "timeout": 300,
            "statusMessage": "Generating mod engine types"
          },
          {
            "type": "command",
            "command": "command -v prek >/dev/null || exit 0; prek install --quiet",
            "statusMessage": "Installing the prek commit hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/ox\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PREK_HOME=\"$CLAUDE_PROJECT_DIR/.prek\" bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop\""
          }
        ]
      }
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": ["www.schemastore.org"]
    },
    "excludedCommands": ["ssh:*", "scp:*", "rsync:*", "vm:*", "aws:*"]
  }
}
