{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "auto",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(man:*)",
      "Bash(wt list:*)",
      "Bash(wt --help:*)",
      "Bash(wt --version:*)",
      "Bash(wt config:*)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:rubygems.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:proxy.golang.org)",
      "WebFetch(domain:sum.golang.org)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:api.linear.app)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:bun.sh)",
      "WebFetch(domain:bun.com)",
      "Edit(tmp/**)",
      "Edit(.git/config)",
      "Edit(.git/config.lock)",
      "Edit(.worktrees/**)",
      "Read(~/.claude/plugins/**)",
      "Bash(tmux display-message:*)",
      "Bash(tmux list-panes:*)",
      "Bash(tmux list-windows:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(glab api:*)",
      "Bash(glab ci get:*)",
      "Bash(glab ci list:*)",
      "Bash(glab ci trace:*)",
      "Bash(glab mr view:*)",
      "Bash(bun:*)",
      "Bash(jq:*)"
    ],
    "deny": []
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "timeout": 86400
          }
        ]
      },
      {
        "hooks": [
          {
            "async": false,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "timeout": 300,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/worktree",
            "if": "Bash(git worktree *)"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/webfetch-block"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "'/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "go@bendrucker": true,
    "mac@bendrucker": true,
    "git@bendrucker": true,
    "gitlab@bendrucker": true,
    "linear@bendrucker": true,
    "things@bendrucker": true,
    "issue@bendrucker": true,
    "review@bendrucker": true,
    "newline@bendrucker": true,
    "github@bendrucker": true,
    "claude-code@bendrucker": true,
    "pull-request@bendrucker": true,
    "interview@bendrucker": true,
    "github@claude-plugins-official": true,
    "personal-review@bendrucker": true,
    "x-callback-url@bendrucker": true,
    "calendar@bendrucker": true,
    "research@bendrucker": true,
    "writing@bendrucker": true,
    "type-ignore@bendrucker": true,
    "agents-md@bendrucker": true,
    "ast-grep@ast-grep-marketplace": true,
    "worktrunk@worktrunk": true,
    "vscode@bendrucker": true,
    "plan@bendrucker": true,
    "playground@claude-plugins-official": true,
    "linear-cli@linear-cli": true,
    "tmux@bendrucker": true,
    "bun@bendrucker": true,
    "mermaid@bendrucker": true,
    "tech-spec@bendrucker": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "bendrucker": {
      "source": {
        "source": "github",
        "repo": "bendrucker/claude"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official",
        "ref": "27d2b86d72da27c64585150857cee8472ad47abb"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins",
        "ref": "f8034678a15ad751aae6a2b684daebac416267a1"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/claude-skill",
        "ref": "577f4d4507678f2c8cee150fae25e6ce309f70b1"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk",
        "ref": "v0.56.0"
      }
    },
    "linear-cli": {
      "source": {
        "source": "github",
        "repo": "schpet/linear-cli",
        "ref": "v2.0.0"
      }
    },
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser",
        "ref": "v0.27.1"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh",
        "~/.tmux",
        "/tmp/claude"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "~/.tmux",
        "~/.terraform.d/plugin-cache",
        "~/.cache",
        "~/Library/Caches/go-build",
        "~/src/go/pkg/mod",
        "~/src/go/pkg/sumdb",
        "~/.bun/install",
        "~/.npm",
        "~/.local/share/uv",
        "~/.local/share/graphite"
      ]
    },
    "excludedCommands": [
      "docker:*",
      "ssh:*",
      "scp:*",
      "rsync:*",
      "aws:*",
      "gcloud:*",
      "az:*",
      "wt:*",
      "claude:*",
      "agent-browser:*",
      "pbcopy:*",
      "pbpaste:*",
      "security:*",
      "defaults:*",
      "screencapture:*",
      "say:*",
      "afplay:*",
      "diskutil:*",
      "networksetup:*",
      "open:*",
      "osascript:*",
      "shortcuts:*",
      "dscl:*",
      "git:*",
      "gh:*",
      "linear:*",
      "code:*"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.ts"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/scripts/subagent-statusline.ts"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "alwaysThinkingEnabled": true,
  "spinnerTipsEnabled": false,
  "showClearContextOnPlanAccept": true,
  "autoCompactEnabled": false,
  "preferredNotifChannel": "terminal_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "teammateMode": "auto",
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_STATUSLINE_RATE_LIMITS_PATH": "~/.vibe-island/cache/rl.json",
    "TMPDIR": "/tmp",
    "TMPPREFIX": "/tmp/claude/zsh",
    "WORKTRUNK_WORKTREE_PATH": ".worktrees/{{ branch | sanitize }}",
    "CLAUDE_CODE_NO_FLICKER": "1"
  }
}
