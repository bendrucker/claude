{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPM Runner Schema",
  "description": "Configuration for NPM-based MCP runners",
  "type": "object",
  "required": ["npm"],
  "properties": {
    "npm": {
      "type": "object",
      "required": ["package"],
      "properties": {
        "package": {
          "type": "string",
          "description": "NPM package name"
        },
        "binary": {
          "type": "string",
          "description": "Binary name to execute"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}