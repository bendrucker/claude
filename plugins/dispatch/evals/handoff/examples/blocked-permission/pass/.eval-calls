wt -C /tmp/eval/cwd switch --create add-deploy-target --base origin/main --no-cd --yes --format=json
rex window new -s session:eval add-deploy-target -c /tmp/eval/cwd/.worktrees/add-deploy-target --json -- claude --name add-deploy-target -- <prompt>
launch add-deploy-target /tmp/eval/cwd/.worktrees/add-deploy-target
allow Bash(bun test:*)
