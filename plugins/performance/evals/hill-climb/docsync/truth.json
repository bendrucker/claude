{
  "kind": "frame",
  "notes": "bench/CLIMB.md",
  "rules": "\\brules\\b",
  "checkpoint": "checkpoint",
  "checks": [
    {
      "id": "mismatch",
      "where": "either",
      "note": "The harness's fixture lockfile matches its manifest, so every benchmark run takes the up-to-date exit and skips fetch, apply, and index. The run a maintainer waits through after a release takes 133.6s.",
      "all": [
        ["bench", "harness", "hyperfine", "fixture"],
        [
          "no-?op",
          "up[- ]to[- ]date",
          "unchanged",
          "nothing (changed|to fetch|to do|to sync)",
          "skip",
          "short-?circuit",
          "early (exit|return)",
          "exits? (early|before)",
          "never (fetch|reach|run|appl)",
          "lock\\w*[^\\n]{0,40}match",
          "zero (packages|changes)",
          "0 of \\d+"
        ],
        ["fetch", "apply", "133", "two minutes", "2 ?min", "\\b2m\\b"]
      ]
    },
    {
      "id": "waits",
      "where": "either",
      "note": "A maintainer runs the sync after each upstream release and waits for it before opening the docs PR.",
      "all": [
        ["\\bwait", "who (runs|waits)"],
        ["maintainer", "release", "by hand", "person", "human", "\\bPR\\b", "user"]
      ]
    },
    {
      "id": "time-split",
      "where": "either",
      "note": "The 4.2.0 release-sync log splits 133.6s into fetch 71.82s and apply 57.89s (relink 41.07s).",
      "all": [
        ["fetch"],
        ["apply"],
        [
          "71(\\.8\\d?)?\\s?s",
          "5[78](\\.\\d+)?\\s?s",
          "133",
          "41(\\.07)?\\s?s",
          "5[34](\\.\\d)?\\s?%",
          "43(\\.\\d)?\\s?%"
        ]
      ]
    },
    {
      "id": "parallelism",
      "where": "rules",
      "note": "The fetch loop downloads 38 archives one at a time, so the Rules must say whether parallelism is in scope.",
      "all": [["parallel", "concurren", "goroutine", "errgroup", "worker pool"]]
    }
  ],
  "assumed": {
    "marker": "\\bassumed[*_`)]*\\s*:",
    "items": [
      { "id": "ceiling", "patterns": ["ceiling"] },
      { "id": "fast-signal", "patterns": ["fast signal", "proxy"] },
      { "id": "guard", "patterns": ["guard"] },
      { "id": "side-effects", "patterns": ["side.effects?"] },
      { "id": "scope", "patterns": ["\\bscope\\b"] },
      { "id": "inputs", "patterns": ["\\binputs?\\b", "holdout"] },
      { "id": "budget", "patterns": ["budget"] },
      { "id": "parallelism", "patterns": ["parallel", "concurren"] }
    ]
  }
}
