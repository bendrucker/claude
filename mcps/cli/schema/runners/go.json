{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Go Runner Schema",
  "description": "Configuration for Go tool based MCP runners",
  "type": "object",
  "required": ["go"],
  "properties": {
    "go": {
      "type": "object",
      "required": ["module"],
      "properties": {
        "module": {
          "type": "string",
          "description": "Go tool module name"
        },
        "args": {
          "type": "array",
          "description": "Arguments to pass to the Go tool",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "description": "Environment variables",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}