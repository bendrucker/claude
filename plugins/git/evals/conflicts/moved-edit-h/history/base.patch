+package ledger
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// ParseCents converts a decimal string such as "12.50" to cents.
+func ParseCents(s string) (int, error) {
+	whole, frac, found := strings.Cut(s, ".")
+	if !found {
+		frac = "00"
+	}
+	if len(frac) != 2 {
+		return 0, fmt.Errorf("want two decimal places in %q", s)
+	}
+	w, err := strconv.Atoi(whole)
+	if err != nil {
+		return 0, err
+	}
+	f, err := strconv.Atoi(frac)
+	if err != nil {
+		return 0, err
+	}
+	if strings.HasPrefix(whole, "-") {
+		f = -f
+	}
+	return w*100 + f, nil
+}
+
+// FormatCents renders cents as a decimal string such as "12.50".
+func FormatCents(c int) string {
+	sign := ""
+	if c < 0 {
+		sign = "-"
+		c = -c
+	}
+	return fmt.Sprintf("%s%d.%02d", sign, c/100, c%100)
+}
