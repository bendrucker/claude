{
  "$schema": "./schema/mcps.json",
  "github": {
    "runner": {
      "http": {
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer ${GITHUB_TOKEN}"
        }
      }
    },
    "targets": {
      "scope": "user"
    }
  },
  "terraform": {
    "runner": {
      "docker": {
        "service": "terraform"
      }
    },
    "targets": {
      "scope": "project",
      "labels": {
        "language": ["terraform"]
      }
    }
  },
  "aws-docs": {
    "runner": {
      "uvx": {
        "package": "awslabs.aws-documentation-mcp-server",
        "env": {
          "FASTMCP_LOG_LEVEL": "ERROR",
          "AWS_DOCUMENTATION_PARTITION": "aws"
        }
      }
    },
    "targets": {
      "scope": "user"
    }
  },
  "package-registry": {
    "runner": {
      "npm": {
        "package": "package-registry-mcp",
        "binary": "package-registry-mcp"
      }
    },
    "targets": {
      "scope": "user"
    }
  },
  "puppeteer": {
    "runner": {
      "npm": {
        "package": "@modelcontextprotocol/server-puppeteer",
        "binary": "mcp-server-puppeteer"
      }
    },
    "targets": {
      "scope": "project",
      "labels": {
        "type": ["frontend", "e2e-testing"]
      }
    }
  },
  "language-server-go": {
    "runner": {
      "binary": {
        "command": "mcp-language-server",
        "args": ["--workspace", ".", "--lsp", "gopls"],
        "env": {
          "PATH": "/Users/ben/src/go/bin:/Users/ben/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin",
          "GOPATH": "/Users/ben/src/go",
          "GOCACHE": "/Users/ben/Library/Caches/go-build",
          "GOMODCACHE": "/Users/ben/src/go/pkg/mod"
        }
      }
    },
    "targets": {
      "scope": "project",
      "labels": {
        "language": ["go"]
      }
    }
  },
  "language-server-typescript": {
    "runner": {
      "binary": {
        "command": "mcp-language-server",
        "args": ["--workspace", ".", "--lsp", "typescript-language-server", "--", "--stdio"],
        "env": {
          "PATH": "${PATH}"
        }
      }
    },
    "targets": {
      "scope": "project",
      "labels": {
        "language": ["typescript", "javascript"]
      }
    }
  }
}
