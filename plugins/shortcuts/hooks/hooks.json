{
  "description": "Gates open command to .shortcut files only",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(open:*)",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/open.ts\""
          }
        ]
      }
    ]
  }
}
