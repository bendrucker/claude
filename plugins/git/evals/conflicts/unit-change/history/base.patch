@@ -0,0 +1,20 @@
+import { expect, test } from "bun:test";
+import { warmCache } from "./cache";
+import { waitForDeploy } from "./deploy";
+import { waitForQueue } from "./queue";
+import { waitForServer } from "./server";
+import type { Wait, WaitOptions } from "./wait";
+
+const callers = { waitForServer, warmCache, waitForQueue, waitForDeploy };
+
+for (const [name, caller] of Object.entries(callers)) {
+  test(`${name} waits on the check it is given`, async () => {
+    let seen: WaitOptions | undefined;
+    const wait: Wait = async (check, options) => {
+      seen = options;
+      return check();
+    };
+    expect(await caller(() => true, wait)).toBe(true);
+    expect(seen?.timeout).toBeGreaterThan(0);
+  });
+}
