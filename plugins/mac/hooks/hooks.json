{
  "description": "Disables the command sandbox for plugin scripts that hand off to macOS automation (Apple Events, Launch Services), and lets git reach ssh remotes through the macOS sandbox proxy",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/sandbox-ssh-proxy.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/sandbox.ts\""
          }
        ]
      }
    ]
  }
}
