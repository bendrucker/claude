{
  "$schema": "./schema/mcps.json",
  "servers": {
    "github": {
      "runner": {
        "http": {
          "url": "https://api.githubcopilot.com/mcp/",
          "headers": {
            "Authorization": "Bearer ${GITHUB_TOKEN}"
          }
        }
      },
      "targets": {
        "scope": "user"
      }
    },
    "terraform": {
      "runner": {
        "docker": {
          "service": "terraform"
        }
      },
      "targets": {
        "scope": "project",
        "labels": {
          "language": ["terraform"]
        }
      }
    },
    "aws-docs": {
      "runner": {
        "uvx": {
          "package": "awslabs.aws-documentation-mcp-server",
          "env": {
            "FASTMCP_LOG_LEVEL": "ERROR",
            "AWS_DOCUMENTATION_PARTITION": "aws"
          }
        }
      },
      "targets": {
        "scope": "user"
      }
    },
    "package-registry": {
      "runner": {
        "npm": {
          "package": "package-registry-mcp",
          "binary": "package-registry-mcp"
        }
      },
      "targets": {
        "scope": "user"
      }
    },
    "language-server-go": {
      "runner": {
        "go": {
          "module": "github.com/isaacphi/mcp-language-server",
          "args": ["--workspace", ".", "--lsp", "gopls"]
        }
      },
      "targets": {
        "scope": "project",
        "labels": {
          "language": ["go"]
        }
      }
    },
    "language-server-typescript": {
      "runner": {
        "go": {
          "module": "github.com/isaacphi/mcp-language-server",
          "args": ["--workspace", ".", "--lsp", "typescript-language-server", "--", "--stdio"]
        }
      },
      "targets": {
        "scope": "project",
        "labels": {
          "language": ["typescript", "javascript"]
        }
      }
    },
    "playwright": {
      "runner": {
        "npm": {
          "package": "@playwright/mcp",
          "binary": "mcp-server-playwright"
        }
      },
      "targets": {
        "scope": "project",
        "labels": {
          "type": ["frontend", "e2e-testing"]
        }
      }
    },
    "markdownify": {
      "runner": {
        "npm": {
          "package": "mcp-markdownify-server",
          "binary": "mcp-markdownify-server"
        }
      },
      "targets": {
        "scope": "user"
      }
    }
  }
}