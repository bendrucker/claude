+import { expect, test } from "bun:test";
+import { select } from "./select";
+import { underAny } from "./paths";
+
+const plugins = [
+  { name: "writing", paths: [] },
+  { name: "review", paths: ["shared/"] },
+];
+
+test("no changed files selects everything", () => {
+  expect(select(plugins, [], [])).toEqual(["writing", "review"]);
+});
+
+test("a claimed path selects its plugin", () => {
+  expect(underAny(["shared/a.ts"], plugins[1]!.paths)).toBe(true);
+  expect(select(plugins, ["shared/a.ts"], [])).toEqual(["review"]);
+});
diff --git a/src/select.ts b/src/select.ts
new file mode 100644
index 0000000..d1a24e7
--- /dev/null
+++ b/src/select.ts
@@ -0,0 +1,27 @@
+import { underAny } from "./paths";
+
+export interface Plugin {
+  name: string;
+  /** Out-of-plugin paths that select it. */
+  paths: string[];
+}
+
+function pluginNames(files: string[]): Set<string> {
+  const plugins = new Set<string>();
+  for (const file of files) {
+    const match = file.match(/^plugins\/([^/]+)\//);
+    if (match?.[1] != null && match[1] !== "") plugins.add(match[1]);
+  }
+  return plugins;
+}
+
+/** Plugins whose jobs a change has to run. */
+export function select(plugins: Plugin[], files: string[], alwaysPaths: string[]): string[] {
+  const all = plugins.map((plugin) => plugin.name);
+  if (files.length === 0 || underAny(files, alwaysPaths)) return all;
+
+  const changed = pluginNames(files);
+  return plugins
+    .filter((plugin) => changed.has(plugin.name) || underAny(files, plugin.paths))
+    .map((plugin) => plugin.name);
+}
