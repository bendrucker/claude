{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HTTP Runner Schema",
  "description": "Configuration for HTTP servers that run remotely",
  "type": "object",
  "required": ["http"],
  "properties": {
    "http": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "HTTP endpoint URL"
        },
        "headers": {
          "type": "object",
          "description": "HTTP headers to include in requests",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}