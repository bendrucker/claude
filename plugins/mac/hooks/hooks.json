{
  "description": "Lets git reach ssh remotes through the macOS sandbox proxy",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/sandbox-ssh-proxy.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
