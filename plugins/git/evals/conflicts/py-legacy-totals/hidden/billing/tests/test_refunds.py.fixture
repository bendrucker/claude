import importlib.util
import unittest

from billing.summary import invoice_total, summarize

LINES = [
    {"qty": 2, "price": 10.0},
    {"qty": 1, "price": 5.0, "refunded": True},
]


class RefundTest(unittest.TestCase):
    def test_refunded_line_is_left_out_of_the_total(self):
        self.assertEqual(invoice_total(LINES, 0), 20.0)

    def test_tax_applies_to_the_remaining_lines(self):
        self.assertEqual(invoice_total(LINES, 0.1), 22.0)

    def test_summary_counts_refunded_lines(self):
        out = summarize([{"id": "a", "lines": LINES}], tax_rate=0)
        self.assertEqual(out["refunded"], 1)
        self.assertEqual(out["total"], 20.0)

    def test_legacy_module_is_gone(self):
        self.assertIsNone(importlib.util.find_spec("billing.legacy_totals"))
