@@ -0,0 +1,12 @@
+from tally.seq import split_chunks
+
+BATCH = 100
+
+
+def load(rows, sink):
+    """Sends rows to sink in batches and returns how many batches went out."""
+    sent = 0
+    for batch in split_chunks(rows, BATCH):
+        sink(batch)
+        sent += 1
+    return sent
