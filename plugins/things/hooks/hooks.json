{
  "description": "Disables sandbox for Things plugin scripts that invoke macOS automation (osascript, open)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PLUGIN_ROOT}/hooks/sandbox.ts",
            "if": "Bash(bun ${CLAUDE_PLUGIN_ROOT}/scripts/:*)"
          }
        ]
      }
    ]
  }
}
