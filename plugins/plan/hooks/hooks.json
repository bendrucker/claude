{
  "description": "Inject planning guidelines when a session reaches plan mode and delegation guidance once a plan grows large, gate plan re-presents, and show a plan's size against the gate's limit",
  "modules": ["../mod/register.ts"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/write-warn.ts\"",
            "if": "Edit(~/.claude/plans/**)"
          },
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/write-warn.ts\"",
            "if": "Write(~/.claude/plans/**)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.ts\""
          }
        ]
      }
    ]
  }
}
