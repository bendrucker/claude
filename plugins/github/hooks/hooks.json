{
  "description": "Transforms GitHub URLs into API requests for better content fetching",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx ${CLAUDE_PLUGIN_ROOT}/scripts/fetch.ts"
          }
        ]
      }
    ]
  }
}
