{
  "name": "pr-body-eval",
  "private": true,
  "scripts": {
    "cases": "bun scripts/cases.ts",
    "fixtures": "bun scripts/fixtures.ts",
    "eval": "bun scripts/fixtures.ts && PROMPTFOO_CONFIG_DIR=$HOME/.cache/promptfoo promptfoo eval",
    "eval:smoke": "bun scripts/fixtures.ts && PROMPTFOO_CONFIG_DIR=$HOME/.cache/promptfoo promptfoo eval --filter-first-n 2",
    "eval:view": "PROMPTFOO_CONFIG_DIR=$HOME/.cache/promptfoo promptfoo view",
    "results": "bun ../../../../evals/scripts/export-run.ts --suite pr-body"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "cleye": "^2.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "promptfoo": "0.122.2"
  }
}
