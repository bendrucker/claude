{
  "description": "Disables sandbox for Things plugin scripts that invoke macOS automation (osascript, open)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(bun ${CLAUDE_PLUGIN_ROOT}/scripts/:*)",
        "hooks": [
          {
            "type": "command",
            "command": "jq '{hookSpecificOutput: {hookEventName: \"PreToolUse\", updatedInput: (.tool_input + {dangerouslyDisableSandbox: true})}}'"
          }
        ]
      }
    ]
  }
}
