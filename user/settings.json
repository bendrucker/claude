{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "auto",
  "permissions": {
    "defaultMode": "auto",
    "deny": []
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "async": false,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.claude/hooks/unless-desktop.sh '/opt/homebrew/bin/moshi-hook' claude-hook",
            "type": "command"
          }
        ]
      }
    ]
  },
  "pluginConfigs": {
    "load@bendrucker": {
      "options": {
        "browserSessions": 3,
        "caps": [
          "build:4:\\b(?:ladle|vite|storybook)(?:\\.js)? build\\b|\\bbuild-storybook\\b",
          "build:4:\\bpytest\\b.* (?:-n ?|--numprocesses[ =])(?:auto|logical|\\d+)\\b",
          "build:4:\\bvitest(?:\\.mjs)?(?=\\s|$)(?!.*\\s(?:--watch|watch|dev)\\b)",
          "build:4:\\bjest(?:\\.js)?(?=\\s|$)(?!.*\\s(?:-i|--runInBand|--watch|--watchAll)\\b)",
          "build:4:\\bplaywright(?:/test/cli\\.js)? test\\b",
          "duckdb:4:(?:^|/)duckdb(?=\\s|$)"
        ],
        "remind": 1.5,
        "warn": 3,
        "refuse": 4
      }
    },
    "linear@bendrucker": {
      "options": {
        "assigned_state": "Todo",
        "unassigned_state": "Backlog"
      }
    },
    "pull-request@bendrucker": {
      "options": {
        "auto_merge": true,
        "stack_file": "wt/stack",
        "body_review_skill": "review:human"
      }
    },
    "things@bendrucker": {
      "options": {
        "link_base": "https://things.bendrucker.me/show?id="
      }
    },
    "session-limit@bendrucker": {
      "options": {
        "overage": true
      }
    },
    "mod-events@bendrucker": {
      "options": {
        "multiplexer": "herdr"
      }
    },
    "friction@bendrucker": {
      "options": {
        "config_repos": ["~/.dotfiles", "~/.claude-repo"]
      }
    }
  },
  "enabledPlugins": {
    "go@bendrucker": true,
    "mac@bendrucker": true,
    "git@bendrucker": true,
    "gitlab@bendrucker": true,
    "linear@bendrucker": true,
    "things@bendrucker": true,
    "issue@bendrucker": true,
    "review@bendrucker": true,
    "newline@bendrucker": true,
    "github@bendrucker": true,
    "auto-mode@bendrucker": true,
    "observability@bendrucker": true,
    "plugin@bendrucker": true,
    "agents@bendrucker": true,
    "prompting@bendrucker": true,
    "evals@bendrucker": true,
    "pull-request@bendrucker": true,
    "x-callback-url@bendrucker": true,
    "research@bendrucker": true,
    "writing@bendrucker": true,
    "type-ignore@bendrucker": true,
    "worktrunk@worktrunk": true,
    "plan@bendrucker": true,
    "mod-events@bendrucker": true,
    "linear-cli@linear-cli": true,
    "bun@bendrucker": true,
    "mermaid@bendrucker": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "atuin@bendrucker": true,
    "friction@bendrucker": true,
    "comments@bendrucker": true,
    "plannotator@plannotator": true,
    "herdr@bendrucker": true,
    "run-command@bendrucker": true,
    "session-limit@bendrucker": true,
    "load@bendrucker": true,
    "performance@bendrucker": true,
    "zsh@bendrucker": true,
    "sandbox@bendrucker": true
  },
  "extraKnownMarketplaces": {
    "bendrucker": {
      "source": {
        "source": "github",
        "repo": "bendrucker/claude"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk",
        "ref": "v0.80.0"
      }
    },
    "linear-cli": {
      "source": {
        "source": "github",
        "repo": "schpet/linear-cli",
        "ref": "v3.0.0"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator",
        "ref": "v0.28.23"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowAppleEvents": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "rubygems.org",
        "proxy.golang.org",
        "sum.golang.org",
        "community-extensions.duckdb.org",
        "bun.sh",
        "github.com",
        "raw.githubusercontent.com",
        "api.github.com",
        "api.individual.githubcopilot.com",
        "gitlab.com",
        "api.linear.app",
        "api.anthropic.com",
        "claude.ai",
        "*.greptile.com",
        "*.coderabbit.ai",
        "auth.docker.io",
        "api.cloudflare.com",
        "dash.cloudflare.com",
        "oidc.us-east-1.amazonaws.com",
        "portal.sso.us-east-1.amazonaws.com",
        "sts.us-east-1.amazonaws.com",
        "results-receiver.actions.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "*.blob.core.windows.net",
        "registry.terraform.io",
        "releases.hashicorp.com",
        "files.pythonhosted.org"
      ],
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.trustd.agent",
        "com.apple.nehelper",
        "com.apple.nesessionmanager",
        "com.apple.SecurityServer"
      ],
      "allowUnixSockets": [
        "~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh",
        "~/.config/herdr/herdr.sock",
        "~/Library/Application Support/rex/server.sock",
        "~/.local/state/vm",
        "~/.docker/run/docker.sock",
        "/tmp/claude"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/private/tmp",
        "~/.herdr/worktrees",
        "~/src/.worktrees",
        "~/src/*/*/.worktrees/**/*",
        "~/.terraform.d/plugin-cache",
        "~/.cache",
        "~/.local/state/friction",
        "~/Library/Caches/go-build",
        "~/Library/Caches/ms-playwright",
        "~/Library/Caches/golangci-lint",
        "~/Library/Caches/com.apple.python",
        "~/src/go/pkg/mod",
        "~/src/go/pkg/sumdb",
        "~/.bun/install",
        "~/.duckdb",
        "~/.gradle",
        "~/.config/glab-cli",
        "~/.config/jgit",
        "~/.config/.wrangler/config",
        "~/.config/.wrangler/logs",
        "~/.config/.wrangler/registry",
        "~/.config/cloudflare",
        "~/.npm",
        "~/.local/share/uv",
        "~/.local/share/graphite",
        "~/.plannotator",
        "~/.local/share/atuin",
        "~/.local/state/vm",
        "~/.local/state/nvim",
        "~/.aws/cli/cache",
        "~/.aws/sso/cache",
        "~/.docker/buildx",
        "~/.greptile",
        "~/.coderabbit",
        "~/.agent-browser",
        "~/.claude/plans",
        "~/.claude/mod-events",
        "/dev/fd",
        "/var/folders/*/*/T/**/*"
      ]
    },
    "excludedCommands": ["git:*", "wt:*", "claude:*", "agent-browser:*", "open:*", "osascript:*"]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.ts"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/scripts/subagent-statusline.ts"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "alwaysThinkingEnabled": true,
  "spinnerTipsEnabled": false,
  "showClearContextOnPlanAccept": true,
  "autoCompactEnabled": true,
  "autoCompactWindow": 280000,
  "preferredNotifChannel": "terminal_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "teammateMode": "in-process",
  "env": {
    "TMPDIR": "/tmp",
    "TMPPREFIX": "/tmp/claude/zsh",
    "WORKTRUNK_WORKTREE_PATH": ".worktrees/{{ branch | sanitize }}",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "NODE_USE_ENV_PROXY": "1",
    "AGENT_BROWSER_IDLE_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_DISABLE_ARTIFACT": "1"
  }
}
