{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactEnabled": true,
  "autoCompactWindow": 400000,
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never git push to the default branch (main or master).",
      "Never force-push to a shared branch or any branch you do not own; only your own stacked-PR branches may be force-pushed."
    ],
    "soft_deny": [
      "$defaults",
      "Pause before destructive filesystem operations such as rm -rf or overwriting existing files outside tmp/ and .worktrees/.",
      "Do not create a pull request or merge request on a third-party repository (one I do not own or maintain) unless I explicitly asked for one; offer it for confirmation first."
    ]
  },
  "cleanupPeriodDays": 90,
  "enabledPlugins": {
    "agents-md@bendrucker": true,
    "ast-grep@ast-grep-marketplace": true,
    "atuin@bendrucker": true,
    "bun@bendrucker": true,
    "claude-code@bendrucker": true,
    "comments@bendrucker": true,
    "git@bendrucker": true,
    "github@bendrucker": true,
    "github@claude-plugins-official": true,
    "gitlab@bendrucker": true,
    "go@bendrucker": true,
    "gopls-lsp@claude-plugins-official": true,
    "interview@bendrucker": true,
    "issue@bendrucker": true,
    "linear-cli@linear-cli": true,
    "linear@bendrucker": true,
    "mac@bendrucker": true,
    "mermaid@bendrucker": true,
    "newline@bendrucker": true,
    "plan@bendrucker": true,
    "pull-request@bendrucker": true,
    "research@bendrucker": true,
    "review@bendrucker": true,
    "things@bendrucker": true,
    "tmux@bendrucker": true,
    "type-ignore@bendrucker": true,
    "typescript-lsp@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "writing@bendrucker": true,
    "x-callback-url@bendrucker": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_STATUSLINE_RATE_LIMITS_PATH": "~/.vibe-island/cache/rl.json",
    "TMPDIR": "/tmp",
    "TMPPREFIX": "/tmp/claude/zsh",
    "WORKTRUNK_WORKTREE_PATH": ".worktrees/{{ branch | sanitize }}"
  },
  "extraKnownMarketplaces": {
    "agent-browser": {
      "source": {
        "ref": "v0.31.1",
        "repo": "vercel-labs/agent-browser",
        "source": "github"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "ref": "c2a9bc154f4ffe08b25d28d5e852dfac8c0d0d8a",
        "repo": "ast-grep/agent-skill",
        "source": "github"
      }
    },
    "astral-sh": {
      "source": {
        "ref": "f3ce88a7ba830f53afd6d944c1d0278ed318e142",
        "repo": "astral-sh/claude-code-plugins",
        "source": "github"
      }
    },
    "bendrucker": {
      "source": {
        "repo": "bendrucker/claude",
        "source": "github"
      }
    },
    "claude-plugins-official": {
      "source": {
        "ref": "87644d1355e6f08d55eb98dc2264d68fa226b6ac",
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
    "linear-cli": {
      "source": {
        "ref": "v2.1.1",
        "repo": "schpet/linear-cli",
        "source": "github"
      }
    },
    "worktrunk": {
      "source": {
        "ref": "v0.68.0",
        "repo": "max-sixty/worktrunk",
        "source": "github"
      }
    }
  },
  "fallbackModel": [
    "sonnet"
  ],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "timeout": 86400,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bun ~/.claude/hooks/worktree",
            "if": "Bash(git worktree *)",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bun ~/.claude/hooks/webfetch-block",
            "type": "command"
          }
        ],
        "matcher": "WebFetch"
      },
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/ben/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/bin/sh -c '[ -x \"$HOME/.vibe-island/bin/vibe-island-bridge\" ] && \"$HOME/.vibe-island/bin/vibe-island-bridge\" --source claude; exit 0'",
            "type": "command"
          },
          {
            "command": "bun ~/.claude/hooks/session-limit",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "bash -c 'p=$(jq -er .worktree_path) || exit 1; [ -e \"$p\" ] && exit 1; exit 0'",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(man:*)",
      "Bash(wt list:*)",
      "Bash(wt --help:*)",
      "Bash(wt --version:*)",
      "Bash(wt config:*)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:rubygems.org)",
      "WebFetch(domain:community-extensions.duckdb.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:gitlab.com)",
      "WebFetch(domain:proxy.golang.org)",
      "WebFetch(domain:sum.golang.org)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:api.linear.app)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:claude.ai)",
      "WebFetch(domain:bun.sh)",
      "WebFetch(domain:bun.com)",
      "WebFetch(domain:*.greptile.com)",
      "WebFetch(domain:*.coderabbit.ai)",
      "Edit(tmp/**)",
      "Edit(.git/config)",
      "Edit(.git/config.lock)",
      "Edit(.worktrees/**)",
      "Read(~/.claude/plugins/**)",
      "Bash(tmux display-message:*)",
      "Bash(tmux list-panes:*)",
      "Bash(tmux list-windows:*)",
      "Bash(tmux capture-pane:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(glab api:*)",
      "Bash(glab ci get:*)",
      "Bash(glab ci list:*)",
      "Bash(glab ci trace:*)",
      "Bash(glab mr view:*)",
      "Bash(bun:*)",
      "Bash(jq:*)"
    ],
    "deny": []
  },
  "preferredNotifChannel": "terminal_bell",
  "sandbox": {
    "allowAppleEvents": true,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "docker:*",
      "ssh:*",
      "scp:*",
      "rsync:*",
      "aws:*",
      "gcloud:*",
      "az:*",
      "pulumi:*",
      "wt:*",
      "claude:*",
      "agent-browser:*",
      "pbcopy:*",
      "pbpaste:*",
      "security:*",
      "defaults:*",
      "screencapture:*",
      "say:*",
      "afplay:*",
      "diskutil:*",
      "networksetup:*",
      "open:*",
      "osascript:*",
      "shortcuts:*",
      "dscl:*",
      "git:*",
      "linear:*",
      "code:*"
    ],
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "~/.tmux",
        "~/.terraform.d/plugin-cache",
        "~/.cache",
        "~/Library/Caches/go-build",
        "~/src/go/pkg/mod",
        "~/src/go/pkg/sumdb",
        "~/.bun/install",
        "~/.config/glab-cli/recover",
        "~/.npm",
        "~/.local/share/uv",
        "~/.local/share/graphite",
        "~/.local/share/atuin"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.trustd.agent"
      ],
      "allowUnixSockets": [
        "~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh",
        "~/.tmux",
        "~/.config/herdr/herdr.sock",
        "/tmp/claude"
      ]
    }
  },
  "showClearContextOnPlanAccept": true,
  "skillOverrides": {
    "dataviz": "user-invocable-only"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "~/.claude/scripts/statusline.ts",
    "type": "command"
  },
  "subagentStatusLine": {
    "command": "~/.claude/scripts/subagent-statusline.ts",
    "type": "command"
  },
  "teammateMode": "in-process",
  "theme": "auto"
}